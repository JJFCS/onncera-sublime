[
    {
        "keys": ["alt+`"],
        "command": "toggle_terminus_panel"
    },

    // BASIC EMACS COMMANDS
	{ "keys": ["alt+w"], "command": "copy" },
	{ "keys": ["alt+x"], "command": "show_overlay", "args": {"overlay": "command_palette"} },
	{ "keys": ["alt+shift+,"], "command": "move_to", "args": {"to": "bof"} },
	{ "keys": ["alt+shift+."], "command": "move_to", "args": {"to": "eof"} },

	{ "keys": ["ctrl+b"], "command": "move", "args": {"by": "characters", "forward": false} },
	{ "keys": ["ctrl+f"], "command": "move", "args": {"by": "characters", "forward": true}  },
	{ "keys": ["ctrl+p"], "command": "move", "args": {"by": "lines",      "forward": false} },
	{ "keys": ["ctrl+n"], "command": "move", "args": {"by": "lines",      "forward": true}  },
	{ "keys": ["ctrl+a"], "command": "move_to", "args": {"to": "bol",     "extend":  false} },
	{ "keys": ["ctrl+e"], "command": "move_to", "args": {"to": "hardeol", "extend":  false} },
	{ "keys": ["ctrl+l"], "command": "show_at_center" },
	{ "keys": ["ctrl+d"], "command": "right_delete"},
	{ "keys": ["ctrl+y"], "command": "paste" },
	{ "keys": ["ctrl+/"], "command": "undo"}, {"keys": ["ctrl+shift+/"], "command": "redo" },
	{ "keys": ["ctrl+x", "ctrl+s"], "command": "save" },
	{ "keys": ["ctrl+x", "ctrl+c"], "command": "exit" },
	{ "keys": ["ctrl+x", "("], "command": "toggle_record_macro" },
	{ "keys": ["ctrl+x", ")"], "command": "toggle_record_macro" },
	{ "keys": ["ctrl+x", "e"], "command": "run_macro" },
	{ "keys": ["ctrl+x", "ctrl+u"], "command": "upper_case" },
	{ "keys": ["ctrl+x", "ctrl+l"], "command": "lower_case" },

	// KILL REGION (DOES NOTHING WITH NO SELECTION INSTEAD OF CUTTING THE WHOLE LINE)
	{ "keys": ["ctrl+w"], "command": "cut",
		"context": [{ "key": "selection_empty", "operator": "equal", "operand": false, "match_all": true }] },

	{ "keys": ["ctrl+k"], "command": "seb_kill_line" },
	{ "keys": ["ctrl+o"], "command": "seb_open_line" },

	{ "keys": ["alt+f"], "command": "seb_move_word", "args": {"forward": true}  },
	{ "keys": ["alt+b"], "command": "seb_move_word", "args": {"forward": false} },

	// MARK (MUST COME AFTER THE BASIC MOVEMENT BINDINGS ABOVE) - TODO update when more navigation keys are included
	{ "keys": ["ctrl+space"], "command": "seb_set_mark" },
	{ "keys": ["ctrl+b"], "command": "move", "args": {"by": "characters", "forward": false, "extend": true},
		"context": [{ "key": "setting.onncera_mark_active", "operator": "equal", "operand": true }] },
	{ "keys": ["ctrl+f"], "command": "move", "args": {"by": "characters", "forward": true,  "extend": true},
		"context": [{ "key": "setting.onncera_mark_active", "operator": "equal", "operand": true }] },
	{ "keys": ["ctrl+p"], "command": "move", "args": {"by": "lines",      "forward": false, "extend": true},
		"context": [{ "key": "setting.onncera_mark_active", "operator": "equal", "operand": true }] },
	{ "keys": ["ctrl+n"], "command": "move", "args": {"by": "lines",      "forward": true,  "extend": true},
		"context": [{ "key": "setting.onncera_mark_active", "operator": "equal", "operand": true }] },
	{ "keys": ["ctrl+a"], "command": "move_to", "args": {"to": "bol",     "extend": true},
		"context": [{ "key": "setting.onncera_mark_active", "operator": "equal", "operand": true }] },
	{ "keys": ["ctrl+e"], "command": "move_to", "args": {"to": "hardeol", "extend": true},
		"context": [{ "key": "setting.onncera_mark_active", "operator": "equal", "operand": true }] },
	{ "keys": ["alt+shift+,"], "command": "move_to", "args": {"to": "bof", "extend": true},
		"context": [{ "key": "setting.onncera_mark_active", "operator": "equal", "operand": true }] },
	{ "keys": ["alt+shift+."], "command": "move_to", "args": {"to": "eof", "extend": true},
		"context": [{ "key": "setting.onncera_mark_active", "operator": "equal", "operand": true }] },

	// SIMULATING EMACS CTRL+G
	// THESE ARE IN REVERSE ORDER BECAUSE IT SEEMS TO BE THE WAY SUBLIME LIKES IT

	{"keys": ["ctrl+g"], "command": "seb_quit"},  // CATCH ALL - CLEAR SELECTION , DEACTIVATE MARK , DOES NOT FALL BACK TO GOTO LINE

	{
		"keys": ["ctrl+g"],
		"command": "hide_popup",
		"context": [
			{ "key": "popup_visible", "operator": "equal", "operand": true }
		]
	},

	{
		"keys": ["ctrl+g"],
		"command": "hide_auto_complete",
		"context": [
			{ "key": "auto_complete_visible", "operator": "equal", "operand": true }
		]
	},

	{
		"keys": ["ctrl+g"],
		"command": "hide_overlay",
		"context": [
			{ "key": "overlay_visible", "operator": "equal", "operand": true },
			{ "key": "panel_has_focus", "operator": "equal", "operand": false }
		]
	},

	{
		"keys": ["ctrl+g"],
		"command": "hide_panel",
		"args": { "cancel": true },
		"context": [
			{ "key": "panel_visible", "operator": "equal", "operand": true }
		]
	},

	{
		"keys": ["ctrl+g"],
		"command": "clear_fields",
		"context": [
			{ "key": "has_prev_field", "operator": "equal", "operand": true }
		]
	},

	{
		"keys": ["ctrl+g"],
		"command": "clear_fields",
		"context": [
			{ "key": "has_next_field", "operator": "equal", "operand": true }
		]
	},

	{
		"keys": ["ctrl+g"],
		"command": "single_selection",
		"context": [
			{ "key": "num_selections", "operator": "not_equal", "operand": 1 }
		]
	},
]
